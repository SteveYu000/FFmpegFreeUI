<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <AssemblyName>FFmpegFreeUI.Ext.PluginSdk</AssemblyName>
    <RootNamespace>FFmpegFreeUI.Ext.PluginSdk</RootNamespace>
    <Product>FFmpegFreeUI API Extended Edition Ext Plugin SDK</Product>
    <PackageId>FFmpegFreeUI.Ext.PluginSdk</PackageId>
    <Description>FFmpegFreeUI API Extended Edition 的 Ext Plugin API 公共合同。</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SteveYu000/FFmpegFreeUI-API-Extended-Edition</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>2.3.0</Version>
    <!-- 2.x 仅追加契约成员，保持程序集版本可兼容已编译的 2.0 插件。 -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="\" />
    <None Include="FFmpegFreeUI.Ext.PluginSdk.Deploy.targets"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="buildTransitive\FFmpegFreeUI.Ext.PluginSdk.targets" />
  </ItemGroup>

</Project>
